{
  "expo": {
    "name": "CineApp",
    "slug": "cineapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cineapp-icon.png",
    "scheme": "cineapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1033",
        "foregroundImage": "./assets/images/cineapp-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/cineapp-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cineapp-logo.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#1A1033"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
